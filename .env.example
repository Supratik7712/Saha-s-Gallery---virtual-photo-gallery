# Copy this file to `.env` and fill in values from your own backend project.
# Never commit a real `.env` with credentials.

# Browser-safe values (exposed to the client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Read by server functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
